# ===== Banco de dados =====
# Dev local (SQLite, zero-config):
DATABASE_URL="file:./dev.db"
# Produção (Postgres): troque por algo como:
# DATABASE_URL="postgresql://user:senha@host:5432/crm?schema=public"

# ===== Cérebro de IA (Anthropic) =====
# Sem esta chave o CRM funciona com fallback heurístico (regex de datas/valores/modelos).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# ===== Acesso (login pessoal) =====
# Se vazio, o app NÃO pede senha (modo demo). Defina para ativar o login.
APP_PASSWORD=""
# Segredo para assinar o cookie de sessão (qualquer string longa e aleatória).
AUTH_SECRET="troque-este-segredo-em-producao"

# ===== WhatsApp Business (Meta Cloud API) — opcional, ativa o módulo =====
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="crm-newholland-verify"

# ===== Google Agenda (OAuth) — opcional, ativa o módulo =====
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
