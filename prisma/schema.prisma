// CRM Inteligente — Vendas de Máquinas Pesadas (New Holland)
// Produção: PostgreSQL (Neon / Vercel Postgres).
// Dev local: defina DATABASE_URL com a string do Neon ou use um Postgres local.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Municipio {
  id       String  @id @default(cuid())
  nome     String  @unique
  regiao   String  @default("Sul do Espírito Santo")
  lat      Float?
  lng      Float?
  foraDeArea Boolean @default(false)
  clientes Cliente[]
}

model Cliente {
  id              String    @id @default(cuid())
  nome            String
  telefone        String?
  email           String?
  endereco        String?
  municipio       Municipio? @relation(fields: [municipioId], references: [id])
  municipioId     String?
  perfilIA        String?
  origem          String?
  jaComprou       Boolean   @default(false)
  visitado        Boolean   @default(false)
  fotoUrl         String?
  observacoes     String?
  ultimoContato   DateTime?
  aguardandoResposta Boolean @default(false)
  perfilDISC      String?
  abordagemIA     String?
  dataCompra      DateTime?
  maquinaComprada String?
  interesseFuturo Boolean   @default(false)
  interesseFuturoData DateTime?
  interesseFuturoNota String?
  status          String    @default("potencial")
  proximaVisita   DateTime?
  proximaVisitaNota String?
  resumoMaquinas  String?
  resumoValor     Float?
  resumoEntrada   Float?
  resumoCondicao  String?
  resumoTexto     String?
  leadScore       Int       @default(50) // Fase 5: score 0-100 recalculado pelo ZEUS (recência+sentimento+valor+estágio+sinais de compra)
  leadScoreAtualizadoEm DateTime?
  // Orientador de Vendas: card ocultado (X vermelho ou ✓ negociação criada)
  // nesta data — volta a aparecer quando chega mensagem nova depois dela.
  orientadorOcultoEm DateTime?
  // Google Contatos: resourceName ("people/c123") do contato ligado a este
  // cliente e quando foi sincronizado pela última vez.
  googleContatoId String?
  googleSincronizadoEm DateTime?
  indicadoPor     Cliente?  @relation("Indicacoes", fields: [indicadoPorId], references: [id])
  indicadoPorId   String?
  indicados       Cliente[] @relation("Indicacoes")
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt
  negociacoes    Negociacao[]
  alertas        Alerta[]
  tarefas        TarefaKanban[]
  visitas        Visita[]
  frota          ClienteMaquina[]
  orientador     OrientadorAnalise?
  posVendaContatos PosVendaContato[]
  cadencias      Cadencia[]
  @@index([leadScore])
  @@index([googleContatoId])
  @@index([aguardandoResposta, ultimoContato])
}

// Setor de Pós-venda: histórico de contatos/ações com um cliente que já
// comprou (ligação, visita, manutenção, peça vendida, indicação pedida etc.)
// — usado pra saber há quanto tempo o cliente não recebe atenção pós-venda.
// Cadência de follow-up de 7 toques (Academia, m4a6): prospecção que não
// respondeu recebe 7 contatos em 30 dias, alternando canais. O ZEUS prepara
// os toques de WhatsApp como rascunho e cria alertas para ligação/visita.
// Encerra sozinha quando o cliente responde ou quando o 7º toque sai.
model Cadencia {
  id                 String    @id @default(cuid())
  cliente            Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId          String
  tipo               String    @default("geral") // construtora | pedreira | cafe | prefeitura | locadora | geral
  toqueAtual         Int       @default(0)       // último toque executado (0 = nenhum)
  proximoToqueEm     DateTime
  ativa              Boolean   @default(true)
  iniciadaEm         DateTime  @default(now())
  encerradaEm        DateTime?
  motivoEncerramento String?   // respondeu | concluida | manual | sem_telefone
  @@index([ativa, proximoToqueEm])
  @@index([clienteId])
}

// Respostas prontas do WhatsApp (modelos por situação, com {nome} e {vendedor}).
model RespostaPronta {
  id        String   @id @default(cuid())
  titulo    String
  texto     String
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())
}

model PosVendaContato {
  id        String   @id @default(cuid())
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  tipo      String   // ligacao | visita | whatsapp | manutencao | peca_vendida | indicacao_pedida | ideia_ia | outro
  nota      String
  data      DateTime @default(now())
  criadoEm  DateTime @default(now())
  @@index([clienteId, data])
}

// Painel "Orientador de Vendas" — snapshot mais recente da análise de
// coaching comercial (IA) para o cliente, gerado a cada mensagem de WhatsApp
// com contexto completo (histórico + cadastro + negociações + financiamento).
model OrientadorAnalise {
  id                      String   @id @default(cuid())
  cliente                 Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId               String   @unique
  estagioVenda            String
  perfilComprador         String?
  objecoes                String[]
  probabilidadeFechamento Int?
  probabilidadeExplicacao String?
  temperatura             String
  proximaAcao             String?
  melhorResposta          String?
  oportunidadesPerdidas   String[]
  resumoNegociacao        String?
  // O que já ficou combinado na conversa (visita, envio de proposta…) e o
  // que ainda está pendente — para a próxima ação nunca repetir o que já foi feito.
  combinados              String[] @default([])
  pendencias              String[] @default([])
  // Coaching completo (personalidade, condução, alerta, roteiro…) — ver
  // lib/zeus/orientador-coaching.ts.
  coaching                Json?
  atualizadoEm            DateTime @updatedAt
}

model ClienteMaquina {
  id         String   @id @default(cuid())
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  String
  marca      String
  modelo     String
  criadoEm  DateTime @default(now())
}

model Visita {
  id         String   @id @default(cuid())
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  String
  data       DateTime
  observacao String?
  // Cidade/local da visita (pode ser diferente do município do cadastro —
  // obra em outra cidade). Usada no mapa da semana.
  cidade     String?
  // Evento correspondente na Google Agenda (integração OAuth) — para apagar
  // junto quando a visita é removida.
  googleEventId String?
  // agendada | realizada | nao_realizada. A meta de visitas conta só as
  // realizadas (confirmadas pelo vendedor com o ✓).
  status         String    @default("agendada")
  realizadaEm    DateTime?
  // Visita criada ao reagendar outra (aponta para a original não realizada).
  reagendadaDeId String?
  criadoEm  DateTime @default(now())
  @@index([status, data])
}

model Negociacao {
  id                    String    @id @default(cuid())
  cliente               Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId             String
  marca                 String?   // New Holland | Dynapac
  maquinaModelo         String?
  valor                 Float?
  tipoPagamento         String?   // avista | financiamento | consorcio | crd_pme | outro
  condicaoPagamento     String?   // legado / texto livre
  // Campos financiamento
  bancoFinanciamento    String?
  entradaValor          Float?
  entradaPercentual     Float?
  // Campos à vista
  dataPagamentoAvista   DateTime?
  pagamentoNaEntrega    Boolean   @default(false)
  // Campos consórcio
  consorcioTipo         String?   // new_holland | outro
  consorcioCotas        Int?
  consorcioCredito      Float?
  // Campos CRD PME
  crdSaldoParcelasQtd   Int?
  crdParcelaValor       Float?
  // Negociação antiga (vendas históricas)
  negociacaoAntiga      Boolean   @default(false)
  mesAnoReferencia      String?   // formato "YYYY-MM" para vendas antigas
  // Controle de estágio e status
  concorrenteMencionado String?
  estagio               String    @default("novo")
  termometro            Int       @default(50)
  proximaAcao           String?
  ultimoContato         DateTime?
  dataVisita            DateTime?
  status                String    @default("aberta") // aberta | ganha | perdida
  motivoPerda           String?
  faturadoEm            DateTime? // data em que chegou na coluna FATURADO
  // Usada na troca: entra como parte da entrada; ao faturar, vai sozinha
  // para o estoque de Máquinas Usadas (usadaEstoqueId guarda o vínculo).
  usadaTroca            Boolean   @default(false)
  usadaMarca            String?
  usadaModelo           String?
  usadaAno              Int?
  usadaHorimetro        Int?
  usadaEstado           String?   // seminova | boa | regular
  usadaValor            Float?
  usadaObs              String?
  usadaEstoqueId        String?
  // Controle de pagamento da comissão (0,5% sobre o valor faturado)
  comissaoPaga          Boolean   @default(false)
  comissaoPagaMes       String?   // "YYYY-MM" — mês em que a comissão foi paga
  comissaoPagaEm        DateTime? // timestamp de quando foi confirmada
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt
  proposta              Proposta?
}

// Proposta comercial de uma página (situação → solução → retorno em reais →
// condição → prova → validade) + calculadora de custo por hora / TCO. Os
// dados ficam em JSON (`dados`) para evoluir sem migração a cada campo novo.
model Proposta {
  id            String     @id @default(cuid())
  negociacao    Negociacao @relation(fields: [negociacaoId], references: [id], onDelete: Cascade)
  negociacaoId  String     @unique
  dados         String     // JSON: DadosProposta (lib/proposta.ts)
  enviadaEm     DateTime?
  criadoEm      DateTime   @default(now())
  atualizadoEm  DateTime   @updatedAt
}

model Maquina {
  id                String  @id @default(cuid())
  marca             String  @default("New Holland")
  modelo            String
  categoria         String
  proprio           Boolean @default(false)
  maisComercializado Boolean @default(false)
  volumeVendas      Int     @default(0)
  pesoOperacional   Float?
  potencia          Int?
  valorInicial      Float?
  consumoLitrosHora Float?
  argumentos        String?
  descricao         String?
  especificacoes    String?
  pontosFortes      String?
  diferenciais      String?
  curiosidades      String?
  imagemUrl         String?
  aplicacoes        String? // setor de aplicações: nichos/segmentos de mercado e operações que a máquina realiza
  notas             NotaMaquina[]
  @@unique([marca, modelo])
}

// Comparativo 2.0 (Fase 2B): conhecimento do vendedor sobre uma máquina
// própria, opcionalmente contra um concorrente específico. Alimenta o resumo
// de diferenciais com IA e o comparativo completo — nunca specs inventadas.
model NotaMaquina {
  id            String   @id @default(cuid())
  maquina       Maquina  @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  maquinaId     String
  concorrenteId String?  // opcional: nota específica contra um concorrente
  texto         String
  criadoEm      DateTime @default(now())
  @@index([maquinaId])
}

// Demandas: lista única de tarefas do vendedor (manuais e automáticas).
// coluna: "demandas" (aberta) | "demandas_concluida" (feita) — nome mantido
// por compatibilidade com dados antigos.
model TarefaKanban {
  id         String    @id @default(cuid())
  titulo     String
  descricao  String?
  coluna     String    @default("demandas")
  ordem      Int       @default(0)
  checklist  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteId  String?
  dueDate    DateTime?
  cidade     String?
  prioridade String    @default("normal") // alta | normal | baixa
  origem     String    @default("manual") // manual | orientador | cadencia | posvenda | cerebro | zeus
  chave      String?   // chave de deduplicação das automáticas (origem:cliente:tipo)
  concluidaEm DateTime?
  criadoEm  DateTime  @default(now())
  @@index([coluna, dueDate])
}


// Itens da Central de alertas que o vendedor marcou como resolvidos. A chave
// é o id do item (ex.: "aguardando:<clienteId>"). Quando o cliente manda
// mensagem nova depois de ocultoEm, a linha é apagada e o item volta.
// Telefones de contatos que não são clientes (contabilidade, banco, hotel…):
// mensagens deles são descartadas na chegada e a sincronização com o Google
// os ignora. Preenchido pela limpeza automática (lib/contatos-bloqueados.ts).
model ContatoBloqueado {
  id       String   @id @default(cuid())
  telefone String   @unique
  nome     String?
  motivo   String?
  criadoEm DateTime @default(now())
}

// Compromisso que não é visita a cliente: feira, convenção, treinamento,
// viagem. Pode durar vários dias e acontecer fora do ES (daí guardar a UF).
model Evento {
  id         String   @id @default(cuid())
  titulo     String
  inicio     DateTime
  fim        DateTime
  diaInteiro Boolean  @default(true)
  uf         String?
  cidade     String?
  observacao String?
  criadoEm   DateTime @default(now())
  @@index([inicio, fim])
}

// Conversa de WhatsApp apagada pelo vendedor: só mensagem posterior a
// excluidaEm pode recriá-la. Sem isso a importação de histórico (ou o
// WhatsApp reenviando mensagens antigas) trazia tudo de volta.
model ConversaExcluida {
  telefone   String   @id
  excluidaEm DateTime @default(now())
}

// Unificação de cadastros duplicados: cada rodada guarda, em JSON, tudo o que
// foi movido/apagado/preenchido para poder ser desfeita exatamente.
model UnificacaoClientes {
  id         String    @id @default(cuid())
  criadoEm   DateTime  @default(now())
  origem     String    @default("usuario")
  resumo     String
  dados      String
  desfeitaEm DateTime?
}

// Link antigo (/clientes/<id que sumiu>) abre o cadastro que ficou.
model ClienteRedirecionamento {
  deId          String   @id
  paraId        String
  unificacaoId  String
  criadoEm      DateTime @default(now())
  @@index([unificacaoId])
}

model AlertaOculto {
  id        String   @id @default(cuid())
  chave     String   @unique
  clienteId String?
  ocultoEm  DateTime @default(now())
}

model ColunaFunil {
  id        String   @id @default(cuid())
  titulo    String
  cor       String   @default("border-t-slate-400")
  ordem     Int      @default(0)
  fixa      Boolean  @default(false)
  // Papel da coluna no funil (independe do título, que o usuário pode
  // renomear): em_negociacao | banco | confirmada | faturado | perdida.
  papel     String?
  // Probabilidade de fechamento (0-100) de quem está nesta coluna — base do
  // valor ponderado do funil.
  probabilidade Int  @default(50)
  criadoEm DateTime @default(now())
}

model MaquinaUsada {
  id           String   @id @default(cuid())
  marca        String
  modelo       String
  categoria    String   @default("outro")
  ano          Int?
  horimetro    Int?
  preco        Float?
  estado       String   @default("boa")
  localizacao  String?
  descricao    String?
  fotoUrl      String?
  status       String   @default("disponivel")
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Alerta {
  id         String   @id @default(cuid())
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  String
  tipo       String
  mensagem   String
  diasDesde  Int      @default(0)
  severidade String   @default("media")
  resolvido  Boolean  @default(false)
  criadoEm  DateTime @default(now())
}

model EstiloDeFala {
  id           String   @id @default(cuid())
  guia         String
  exemplos     String?
  atualizadoEm DateTime @updatedAt @default(now())
}

model Configuracao {
  chave String @id
  valor String
}

model EstrategiaVenda {
  id         String   @id @default(cuid())
  titulo     String
  categoria  String
  perfilAlvo String?
  conteudo   String
  fonte      String   @default("ia")
  favorito   Boolean  @default(false)
  criadoEm  DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  acao        String
  origem      String   @default("ia")
  descricao   String
  entidade    String?
  entidadeId  String?
  clienteId   String?
  extra       String?
  criadoEm   DateTime @default(now())
}

model WhatsAppConversation {
  id               String    @id @default(cuid())
  externalPhone    String
  lid              String?
  contactName      String?
  isGroup          Boolean   @default(false)
  groupName        String?
  status           String    @default("UNASSIGNED")
  category         String?
  categoryConfirmed Boolean  @default(false)
  aiActive         Boolean   @default(false)
  // "Marcar como respondido": assunto concluído, sem pendência — some das
  // listas/relatórios de pendência do CRM até chegar mensagem nova (enviada
  // ou recebida), quando volta a contar sozinho. Coluna no banco continua
  // "ignored" (era a antiga função de ignorar conversa) para não migrar.
  encerrada        Boolean   @default(false) @map("ignored")
  lastMessageAt    DateTime  @default(now())
  lastAccessedAt   DateTime?
  contactPhotoUrl  String?
  agnesScheduledAt DateTime?
  // Relatório de conversas (PDF): resumo IA em cache, válido enquanto
  // resumoRelatorioEm >= lastMessageAt (nova mensagem invalida).
  resumoRelatorio   String?
  resumoRelatorioEm DateTime?
  clienteId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         WhatsAppMessage[]
  @@index([lid])
  @@index([lastMessageAt])
  @@index([agnesScheduledAt])
  @@unique([externalPhone])
}

model WhatsAppMessage {
  id                   String    @id @default(cuid())
  conversationId       String
  direction            String
  body                 String
  operatorDisplayName  String?
  senderName           String?
  mediaUrl             String?
  mediaType            String?
  mediaName            String?
  transcript           String?
  sentAt               DateTime  @default(now())
  isDraft              Boolean   @default(false)
  draftStatus          String?
  zapiMessageId        String?
  origin               String?
  sendStatus           String?
  retryCount           Int       @default(0)
  lastRetryAt          DateTime?
  lastSendError        String?
  processedAt          DateTime?
  conversation         WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, sentAt])
  @@index([zapiMessageId])
  @@index([sendStatus])
  @@index([processedAt])
}

model WhatsAppSettings {
  id           String  @id @default(cuid())
  instanceId   String  @default("")
  token        String  @default("")
  clientToken  String  @default("")
  apiUrl       String  @default("https://api.z-api.io")
  isActive     Boolean @default(false)
  auditMode    Boolean @default(true)
  // Resposta automática: só dentro da janela (hora de Brasília) e até o
  // limite diário — fora disso vira rascunho. Protege a reputação do número.
  autoHoraInicio Int   @default(7)
  autoHoraFim    Int   @default(20)
  autoLimiteDia  Int   @default(40)
  updatedAt    DateTime @updatedAt
}

// ZEUS (Fase 4): centro de comando autônomo. Substitui o zapi-diag como
// registro de eventos (health/fix/alerta/acao/erro) — feed do painel /zeus.
model ZeusEvent {
  id         String   @id @default(cuid())
  tipo       String   // health | fix | alerta | acao | erro
  severidade String   @default("media") // baixa | media | alta | critica
  titulo     String
  detalhe    String?  // JSON livre
  // Quantas vezes esse MESMO evento (tipo+título) aconteceu seguido — em vez
  // de uma linha nova a cada repetição (ver registrarZeusEvent).
  ocorrencias Int     @default(1)
  resolvido  Boolean  @default(false)
  criadoEm   DateTime @default(now())
  @@index([tipo, criadoEm])
  @@index([resolvido])
}

// Cérebro agêntico (Fase 3): histórico persistido no servidor. Cada
// CerebroMessage guarda o(s) content block(s) da Anthropic (texto, tool_use,
// tool_result) como JSON em `content`, na ordem exata do turno — permite
// reconstruir o array `messages` da API a cada nova pergunta sem depender do
// cliente reenviar o histórico (frágil e sem validação).
model CerebroSession {
  id         String          @id @default(cuid())
  titulo     String?
  criadoEm   DateTime        @default(now())
  atualizadoEm DateTime      @updatedAt
  mensagens  CerebroMessage[]
}

model CerebroMessage {
  id         String   @id @default(cuid())
  session    CerebroSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  role       String   // user | assistant
  content    String   // JSON: string simples ou array de content blocks da Anthropic
  criadoEm   DateTime @default(now())
  @@index([sessionId, criadoEm])
}
