// CRM Inteligente — Vendas de Máquinas Pesadas (New Holland)
// Produção: PostgreSQL (Neon / Vercel Postgres).
// Dev local: defina DATABASE_URL com a string do Neon ou use um Postgres local.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Municipio {
  id       String  @id @default(cuid())
  nome     String  @unique
  regiao   String  @default("Sul do Espírito Santo")
  lat      Float?
  lng      Float?
  foraDeArea Boolean @default(false)
  clientes Cliente[]
}

model Cliente {
  id              String    @id @default(cuid())
  nome            String
  telefone        String?
  email           String?
  endereco        String?
  municipio       Municipio? @relation(fields: [municipioId], references: [id])
  municipioId     String?
  perfilIA        String?
  origem          String?
  jaComprou       Boolean   @default(false)
  visitado        Boolean   @default(false)
  fotoUrl         String?
  observacoes     String?
  ultimoContato   DateTime?
  aguardandoResposta Boolean @default(false)
  perfilDISC      String?
  abordagemIA     String?
  dataCompra      DateTime?
  maquinaComprada String?
  interesseFuturo Boolean   @default(false)
  interesseFuturoData DateTime?
  interesseFuturoNota String?
  status          String    @default("potencial")
  proximaVisita   DateTime?
  proximaVisitaNota String?
  resumoMaquinas  String?
  resumoValor     Float?
  resumoEntrada   Float?
  resumoCondicao  String?
  resumoTexto     String?
  leadScore       Int       @default(50) // Fase 5: score 0-100 recalculado pelo ZEUS (recência+sentimento+valor+estágio+sinais de compra)
  leadScoreAtualizadoEm DateTime?
  indicadoPor     Cliente?  @relation("Indicacoes", fields: [indicadoPorId], references: [id])
  indicadoPorId   String?
  indicados       Cliente[] @relation("Indicacoes")
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt
  negociacoes    Negociacao[]
  conversas      Conversa[]
  alertas        Alerta[]
  sugestoes      SugestaoVinculo[]
  tarefas        TarefaKanban[]
  visitas        Visita[]
  frota          ClienteMaquina[]
  orientador     OrientadorAnalise?
  @@index([leadScore])
}

// Painel "Orientador de Vendas" — snapshot mais recente da análise de
// coaching comercial (IA) para o cliente, gerado a cada mensagem de WhatsApp
// com contexto completo (histórico + cadastro + negociações + financiamento).
model OrientadorAnalise {
  id                      String   @id @default(cuid())
  cliente                 Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId               String   @unique
  estagioVenda            String
  perfilComprador         String?
  objecoes                String[]
  probabilidadeFechamento Int?
  probabilidadeExplicacao String?
  temperatura             String
  proximaAcao             String?
  melhorResposta          String?
  oportunidadesPerdidas   String[]
  resumoNegociacao        String?
  atualizadoEm            DateTime @updatedAt
}

model ClienteMaquina {
  id         String   @id @default(cuid())
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  String
  marca      String
  modelo     String
  criadoEm  DateTime @default(now())
}

model Visita {
  id         String   @id @default(cuid())
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  String
  data       DateTime
  observacao String?
  criadoEm  DateTime @default(now())
}

model Negociacao {
  id                    String    @id @default(cuid())
  cliente               Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId             String
  marca                 String?   // New Holland | Dynapac
  maquinaModelo         String?
  valor                 Float?
  tipoPagamento         String?   // avista | financiamento | consorcio | crd_pme | outro
  condicaoPagamento     String?   // legado / texto livre
  // Campos financiamento
  bancoFinanciamento    String?
  entradaValor          Float?
  entradaPercentual     Float?
  // Campos à vista
  dataPagamentoAvista   DateTime?
  pagamentoNaEntrega    Boolean   @default(false)
  // Campos consórcio
  consorcioTipo         String?   // new_holland | outro
  consorcioCotas        Int?
  consorcioCredito      Float?
  // Campos CRD PME
  crdSaldoParcelasQtd   Int?
  crdParcelaValor       Float?
  // Negociação antiga (vendas históricas)
  negociacaoAntiga      Boolean   @default(false)
  mesAnoReferencia      String?   // formato "YYYY-MM" para vendas antigas
  // Controle de estágio e status
  concorrenteMencionado String?
  estagio               String    @default("novo")
  termometro            Int       @default(50)
  proximaAcao           String?
  ultimoContato         DateTime?
  dataVisita            DateTime?
  status                String    @default("aberta") // aberta | ganha | perdida
  motivoPerda           String?
  faturadoEm            DateTime? // data em que chegou na coluna FATURADO
  // Controle de pagamento da comissão (0,5% sobre o valor faturado)
  comissaoPaga          Boolean   @default(false)
  comissaoPagaMes       String?   // "YYYY-MM" — mês em que a comissão foi paga
  comissaoPagaEm        DateTime? // timestamp de quando foi confirmada
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt
  analises              AnaliseIA[]
}

model Maquina {
  id                String  @id @default(cuid())
  marca             String  @default("New Holland")
  modelo            String
  categoria         String
  proprio           Boolean @default(false)
  maisComercializado Boolean @default(false)
  volumeVendas      Int     @default(0)
  pesoOperacional   Float?
  potencia          Int?
  valorInicial      Float?
  consumoLitrosHora Float?
  argumentos        String?
  descricao         String?
  especificacoes    String?
  pontosFortes      String?
  diferenciais      String?
  curiosidades      String?
  imagemUrl         String?
  aplicacoes        String? // setor de aplicações: nichos/segmentos de mercado e operações que a máquina realiza
  midiaPosts        MidiaPost[]
  notas             NotaMaquina[]
  @@unique([marca, modelo])
}

// Comparativo 2.0 (Fase 2B): conhecimento do vendedor sobre uma máquina
// própria, opcionalmente contra um concorrente específico. Alimenta o resumo
// de diferenciais com IA e o comparativo completo — nunca specs inventadas.
model NotaMaquina {
  id            String   @id @default(cuid())
  maquina       Maquina  @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  maquinaId     String
  concorrenteId String?  // opcional: nota específica contra um concorrente
  texto         String
  criadoEm      DateTime @default(now())
  @@index([maquinaId])
}

model Conversa {
  id            String    @id @default(cuid())
  cliente       Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteId     String?
  canal         String    @default("manual")
  tipo          String    @default("texto")
  conteudo      String
  transcricao   String?
  remetente     String    @default("cliente")
  zapiId        String?
  analisadaEm  DateTime?
  criadoEm     DateTime  @default(now())
  analise       AnaliseIA?
  @@index([zapiId])
}

model AnaliseIA {
  id                 String     @id @default(cuid())
  conversa           Conversa?  @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  conversaId         String?    @unique
  negociacao         Negociacao? @relation(fields: [negociacaoId], references: [id], onDelete: SetNull)
  negociacaoId       String?
  resumo             String?
  perfil             String?
  maquina            String?
  valor              Float?
  condicaoPagamento  String?
  concorrente        String?
  dataVisita         DateTime?
  sentimento         String?
  ehProspectReal     Boolean    @default(false)
  rascunhoResposta   String?
  fonte              String     @default("ia")
  criadoEm          DateTime   @default(now())
}

model TarefaKanban {
  id         String    @id @default(cuid())
  titulo     String
  descricao  String?
  coluna     String    @default("a_fazer")
  ordem      Int       @default(0)
  checklist  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteId  String?
  dueDate    DateTime?
  cidade     String?
  criadoEm  DateTime  @default(now())
}

model ColunaDemanda {
  id        String   @id @default(cuid())
  titulo    String
  cor       String   @default("border-t-slate-400")
  ordem     Int      @default(0)
  fixa      Boolean  @default(false)
  criadoEm DateTime @default(now())
}

model ColunaFunil {
  id        String   @id @default(cuid())
  titulo    String
  cor       String   @default("border-t-slate-400")
  ordem     Int      @default(0)
  fixa      Boolean  @default(false)
  criadoEm DateTime @default(now())
}

model MaquinaUsada {
  id           String   @id @default(cuid())
  marca        String
  modelo       String
  categoria    String   @default("outro")
  ano          Int?
  horimetro    Int?
  preco        Float?
  estado       String   @default("boa")
  localizacao  String?
  descricao    String?
  fotoUrl      String?
  status       String   @default("disponivel")
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Meta {
  id         String   @id @default(cuid())
  tipo       String
  rotulo     String
  alvo       Float
  progresso  Float    @default(0)
  periodo    String   @default("mensal")
  criadoEm  DateTime @default(now())
}

model SugestaoVinculo {
  id               String   @id @default(cuid())
  telefone         String
  nomeDetectado    String?
  textoContexto    String?
  clienteSugerido  Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteId        String?
  confianca        Int      @default(50)
  status           String   @default("pendente")
  criadoEm        DateTime @default(now())
}

model Alerta {
  id         String   @id @default(cuid())
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  String
  tipo       String
  mensagem   String
  diasDesde  Int      @default(0)
  severidade String   @default("media")
  resolvido  Boolean  @default(false)
  criadoEm  DateTime @default(now())
}

model MidiaPost {
  id            String    @id @default(cuid())
  maquina       Maquina?  @relation(fields: [maquinaId], references: [id], onDelete: SetNull)
  maquinaId     String?
  titulo        String
  conteudo      String
  status        String    @default("rascunho")
  agendadoPara  DateTime?
  criadoEm     DateTime  @default(now())
}

model EstiloDeFala {
  id           String   @id @default(cuid())
  guia         String
  exemplos     String?
  atualizadoEm DateTime @updatedAt @default(now())
}

model CampanhaMarketing {
  id              String    @id @default(cuid())
  tipo            String
  titulo          String
  conteudo        String
  hashtags        String?
  canalAlvo       String    @default("ambos")
  status          String    @default("rascunho")
  marca           String?
  categoria       String?
  municipioFiltro String?
  feedbackEderson String?
  totalEnviado    Int       @default(0)
  enviadoEm       DateTime?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt
}

model Motivacao {
  id        String   @id @default(cuid())
  texto     String
  autor     String?
  categoria String   @default("vendas")
  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())
}

model Configuracao {
  chave String @id
  valor String
}

model EstrategiaVenda {
  id         String   @id @default(cuid())
  titulo     String
  categoria  String
  perfilAlvo String?
  conteudo   String
  fonte      String   @default("ia")
  favorito   Boolean  @default(false)
  criadoEm  DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  acao        String
  origem      String   @default("ia")
  descricao   String
  entidade    String?
  entidadeId  String?
  clienteId   String?
  extra       String?
  criadoEm   DateTime @default(now())
}

model WhatsAppConversation {
  id               String    @id @default(cuid())
  externalPhone    String
  lid              String?
  contactName      String?
  isGroup          Boolean   @default(false)
  groupName        String?
  status           String    @default("UNASSIGNED")
  category         String?
  categoryConfirmed Boolean  @default(false)
  aiActive         Boolean   @default(false)
  ignored          Boolean   @default(false)
  lastMessageAt    DateTime  @default(now())
  lastAccessedAt   DateTime?
  contactPhotoUrl  String?
  agnesScheduledAt DateTime?
  clienteId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         WhatsAppMessage[]
  @@index([lid])
  @@index([lastMessageAt])
  @@index([agnesScheduledAt])
  @@unique([externalPhone])
}

model WhatsAppMessage {
  id                   String    @id @default(cuid())
  conversationId       String
  direction            String
  body                 String
  operatorDisplayName  String?
  senderName           String?
  mediaUrl             String?
  mediaType            String?
  mediaName            String?
  transcript           String?
  sentAt               DateTime  @default(now())
  isDraft              Boolean   @default(false)
  draftStatus          String?
  zapiMessageId        String?
  origin               String?
  sendStatus           String?
  retryCount           Int       @default(0)
  lastRetryAt          DateTime?
  lastSendError        String?
  processedAt          DateTime?
  conversation         WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, sentAt])
  @@index([zapiMessageId])
  @@index([sendStatus])
  @@index([processedAt])
}

model WhatsAppSettings {
  id           String  @id @default(cuid())
  instanceId   String  @default("")
  token        String  @default("")
  clientToken  String  @default("")
  apiUrl       String  @default("https://api.z-api.io")
  isActive     Boolean @default(false)
  auditMode    Boolean @default(true)
  updatedAt    DateTime @updatedAt
}

// ZEUS (Fase 4): centro de comando autônomo. Substitui o zapi-diag como
// registro de eventos (health/fix/alerta/acao/erro) — feed do painel /zeus.
model ZeusEvent {
  id         String   @id @default(cuid())
  tipo       String   // health | fix | alerta | acao | erro
  severidade String   @default("media") // baixa | media | alta | critica
  titulo     String
  detalhe    String?  // JSON livre
  resolvido  Boolean  @default(false)
  criadoEm   DateTime @default(now())
  @@index([tipo, criadoEm])
  @@index([resolvido])
}

// Cérebro agêntico (Fase 3): histórico persistido no servidor. Cada
// CerebroMessage guarda o(s) content block(s) da Anthropic (texto, tool_use,
// tool_result) como JSON em `content`, na ordem exata do turno — permite
// reconstruir o array `messages` da API a cada nova pergunta sem depender do
// cliente reenviar o histórico (frágil e sem validação).
model CerebroSession {
  id         String          @id @default(cuid())
  titulo     String?
  criadoEm   DateTime        @default(now())
  atualizadoEm DateTime      @updatedAt
  mensagens  CerebroMessage[]
}

model CerebroMessage {
  id         String   @id @default(cuid())
  session    CerebroSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  role       String   // user | assistant
  content    String   // JSON: string simples ou array de content blocks da Anthropic
  criadoEm   DateTime @default(now())
  @@index([sessionId, criadoEm])
}
